/// Find the phase-lock period of Grover operator
pub fn find_phase_lock_period(grover: &GroverSearch, max_iters: usize) -> PhaseLockInfo {
    let mut state = grover.initialize();
    let initial_target_prob = state.probability(grover.target);
    
    let mut measurements = Vec::new();
    let mut prev_prob = initial_target_prob;
    let mut peaks = Vec::new();
    let mut troughs = Vec::new();
    
    for i in 1..=max_iters {
        grover.grover_iteration(&mut state);
        let prob = state.probability(grover.target);
        
        // Detect peaks and troughs
        if i > 1 {
            let prev_prev = measurements.get(i.saturating_sub(2)).copied().unwrap_or(0.0);
            if prev_prob > prev_prev && prev_prob > prob {
                peaks.push((i - 1, prev_prob));
            }
            if prev_prob < prev_prev && prev_prob < prob {
                troughs.push((i - 1, prev_prob));
            }
        }
        
        measurements.push(prob);
        prev_prob = prob;
    }
    
    // Period = distance between consecutive peaks
    let period = if peaks.len() >= 2 {
        peaks[1].0 - peaks[0].0
    } else {
        max_iters  // Couldn't determine
    };
    
    // Optimal = first peak
    let optimal_iter = peaks.first().map(|(i, _)| *i).unwrap_or(1);
    
    PhaseLockInfo {
        period,
        optimal_iteration: optimal_iter,
        first_peak_prob: peaks.first().map(|(_, p)| *p).unwrap_or(0.0),
        peaks,
        troughs,
    }
}
