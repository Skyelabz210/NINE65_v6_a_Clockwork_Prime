//! QMNF Grover Swarm Scheduler
//! Integer-only, Grover-native, gravity-scheduled

use std::collections::{BinaryHeap, HashMap, HashSet};

/// Knowledge atom identifier
type AtomId = u64;

/// Topic label (small integer)
type TopicId = u8;

/// Integer weight
type Weight = u64;

/// Discovery state
#[derive(Clone, Copy, PartialEq, Eq)]
enum DiscoveryState {
    Unknown,
    Sighted,
    Validated,
    Integrated,
}

/// Knowledge atom
struct Atom {
    id: AtomId,
    topic: TopicId,
    state: DiscoveryState,
    weight: Weight,
}

/// Edge in knowledge graph
struct Edge {
    from: AtomId,
    to: AtomId,
}

/// Knowledge graph G_K = (K, E)
struct KnowledgeGraph {
    atoms: HashMap<AtomId, Atom>,
    edges: Vec<Edge>,
    adjacency: HashMap<AtomId, Vec<AtomId>>,
}

/// Frontier atom with innovation potential
#[derive(Eq, PartialEq)]
struct FrontierEntry {
    atom_id: AtomId,
    potential: u64,  // I_t(v)
}

impl Ord for FrontierEntry {
    fn cmp(&self, other: &Self) -> std::cmp::Ordering {
        self.potential.cmp(&other.potential)  // max-heap by potential
    }
}

impl PartialOrd for FrontierEntry {
    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
        Some(self.cmp(other))
    }
}

/// Swarm node
struct SwarmNode {
    id: usize,
    partition: HashSet<AtomId>,    // S_i
    marked_set: HashSet<AtomId>,   // M_i
    weight: Weight,                 // W_i
    budget: u64,                    // b_i (iterations available)
    yield_count: u64,               // y_i
    cost_count: u64,                // c_i
    neighbors: Vec<usize>,          // Γ_i
}

/// Swarm scheduler
struct SwarmScheduler {
    graph: KnowledgeGraph,
    nodes: Vec<SwarmNode>,
    discovered: HashSet<AtomId>,    // D_t
    alpha: u64,                      // reward coefficient
    beta: u64,                       // penalty coefficient
    lambda: u64,                     // diversity bonus
    w_max: Weight,                   // weight cap
}

impl SwarmScheduler {
    /// WAVE 1: Extract frontier with innovation potentials
    fn extract_frontier(&self) -> BinaryHeap<FrontierEntry> {
        let mut pq = BinaryHeap::new();
        
        // Find unknown atoms adjacent to discovered
        for (&atom_id, neighbors) in &self.graph.adjacency {
            let atom = &self.graph.atoms[&atom_id];
            if atom.state != DiscoveryState::Unknown {
                continue;
            }
            
            // Compute N_D(v)
            let validated_neighbors: Vec<_> = neighbors.iter()
                .filter(|&&n| self.discovered.contains(&n))
                .collect();
            
            if validated_neighbors.is_empty() {
                continue;
            }
            
            // Compute topic counts for mix term
            let mut topic_counts: HashMap<TopicId, u64> = HashMap::new();
            let mut weight_sum: u64 = 0;
            
            for &&neighbor_id in &validated_neighbors {
                let neighbor = &self.graph.atoms[&neighbor_id];
                *topic_counts.entry(neighbor.topic).or_insert(0) += 1;
                weight_sum += neighbor.weight;
            }
            
            // mix = Σ_{r<s} c_r · c_s
            let topics: Vec<_> = topic_counts.keys().collect();
            let mut mix: u64 = 0;
            for i in 0..topics.len() {
                for j in (i+1)..topics.len() {
                    mix += topic_counts[topics[i]] * topic_counts[topics[j]];
                }
            }
            
            // I_t(v) = Σ w(u) + λ · mix
            let potential = weight_sum + self.lambda * mix;
            
            pq.push(FrontierEntry { atom_id, potential });
        }
        
        pq
    }
    
    /// WAVE 2: Assign targets to nodes
    fn assign_targets(&mut self, mut pq: BinaryHeap<FrontierEntry>) {
        while let Some(entry) = pq.pop() {
            // Find node with highest weight that contains this atom
            let best_node = self.nodes.iter_mut()
                .filter(|n| n.partition.contains(&entry.atom_id))
                .filter(|n| n.budget > 0)
                .max_by_key(|n| n.weight);
            
            if let Some(node) = best_node {
                node.marked_set.insert(entry.atom_id);
                node.budget = node.budget.saturating_sub(1);
            }
        }
    }
    
    /// WAVE 3: Local Grover cycles (stub - actual Grover in NINE65)
    fn run_grover_cycles(&mut self) -> Vec<(usize, AtomId)> {
        let mut discoveries = Vec::new();
        
        for node in &mut self.nodes {
            if node.marked_set.is_empty() {
                continue;
            }
            
            let m = node.marked_set.len() as u64;
            let n = node.partition.len() as u64;
            
            // θ where sin²(θ) = m/n
            // Optimal iterations ≈ π/(4θ) - 1/2
            // For small m/n: θ ≈ √(m/n), so t* ≈ π√(n/m)/4
            let t_optimal = if m > 0 {
                ((314 * integer_sqrt(n)) / (400 * integer_sqrt(m))).max(1)
            } else {
                0
            };
            
            let iterations = t_optimal.min(node.budget);
            
            // In real implementation: call NINE65 Grover here
            // For now: probabilistic simulation
            for &target in &node.marked_set {
                // Simplified: assume discovery with prob ~ sin²((2t+1)θ)
                // After t_optimal iterations, this approaches 1
                if iterations >= t_optimal / 2 {
                    discoveries.push((node.id, target));
                    node.yield_count += 1;
                    break;  // One discovery per cycle
                }
            }
        }
        
        discoveries
    }
    
    /// WAVE 4: Validation, integration, ripple
    fn process_discoveries(&mut self, discoveries: Vec<(usize, AtomId)>) {
        for (node_id, atom_id) in discoveries {
            // Update atom state
            if let Some(atom) = self.graph.atoms.get_mut(&atom_id) {
                atom.state = DiscoveryState::Validated;
                atom.weight = 100;  // Default confidence
            }
            
            self.discovered.insert(atom_id);
            
            // Ripple: add to marked sets of overlapping nodes
            for node in &mut self.nodes {
                if node.partition.contains(&atom_id) {
                    node.marked_set.insert(atom_id);
                }
            }
        }
        
        // Update weights
        for node in &mut self.nodes {
            let new_weight = node.weight
                .saturating_add(self.alpha * node.yield_count)
                .saturating_sub(self.beta * node.cost_count);
            node.weight = new_weight.min(self.w_max);
            
            // Reset counters
            node.yield_count = 0;
            node.cost_count = 0;
        }
    }
    
    /// Main loop
    pub fn run_wave_protocol(&mut self, max_waves: usize) {
        for wave in 0..max_waves {
            // WAVE 1: Frontier
            let pq = self.extract_frontier();
            if pq.is_empty() {
                break;  // Converged
            }
            
            // WAVE 2: Assign
            self.assign_targets(pq);
            
            // WAVE 3: Grover
            let discoveries = self.run_grover_cycles();
            
            // WAVE 4: Integrate
            self.process_discoveries(discoveries);
            
            // Refill budgets for next wave
            for node in &mut self.nodes {
                node.budget = 100;  // Reset budget
            }
        }
    }
}

/// Integer square root (Newton's method)
fn integer_sqrt(n: u64) -> u64 {
    if n == 0 { return 0; }
    let mut x = n;
    let mut y = (x + 1) / 2;
    while y < x {
        x = y;
        y = (x + n / x) / 2;
    }
    x
}
