# MCP Server API Keys Configuration
# Copy this file to .env and fill in your API keys

# OpenAI Codex/GPT-4
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CODEX_MODEL=gpt-4  # or gpt-4-turbo, gpt-3.5-turbo

# QWEN (via Together AI or Hugging Face)
QWEN_API_KEY=your_qwen_api_key_here
TOGETHER_API_KEY=your_together_api_key_here  # Alternative to QWEN_API_KEY
QWEN_API_ENDPOINT=https://api.together.xyz/v1/chat/completions
QWEN_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here  # Alternative to GOOGLE_API_KEY
GEMINI_MODEL=gemini-2.0-flash-exp  # or gemini-pro, gemini-pro-vision
